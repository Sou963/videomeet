# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files and secrets
.env
.env.*
!.env.example
!.env.local.example
server/.env
server/.env.*
!server/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local editor and OS files
.vscode/
.idea/
*.log
